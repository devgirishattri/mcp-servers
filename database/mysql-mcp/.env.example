# MySQL variable reference only.
# Supply these values through the MCP host; do not copy this file to .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=mcp_ro
DB_PASSWORD=your_password_here
DB_TIMEZONE=Z

# TLS: disable, require, or verify-full
DB_SSL_MODE=disable
# DB_SSL_CA_FILE=certificates/mysql-ca.pem

# Resource Limits
MAX_CONNECTIONS=10
CONNECTION_TIMEOUT_MS=10000
STATEMENT_TIMEOUT_MS=30000
MAX_ROWS=1000
MAX_AFFECTED_ROWS=100
MAX_RESPONSE_BYTES=1000000
MAX_FIELD_BYTES=65536
MAX_COLUMNS=100
MAX_REQUEST_BYTES=262144
MAX_INPUT_BYTES=65536
MAX_INPUT_ITEMS=100

# Tool Guards
DEBUG=false
MCP_MODE=read
VERIFY_DB_PRIVILEGES=true
ALLOW_ARBITRARY_SELECT=false
# ALLOWED_SCHEMAS defaults to DB_NAME
# ALLOWED_SCHEMAS=your_database
# ALLOWED_TABLES=your_database.safe_view,your_database.reporting_table
# ALLOWED_COLUMNS=your_database.safe_view.id,your_database.safe_view.status
# ALLOWED_SELECT_FUNCTIONS=count,min,max,avg,lower,upper
ALLOW_WRITES=false
ALLOW_DELETE=false
RETURN_MUTATION_ROWS=false
AUDIT_LOG=true
