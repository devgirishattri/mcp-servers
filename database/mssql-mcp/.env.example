# SQL Server variable reference only.
# Supply these values through the MCP host; do not copy this file to .env.
DB_HOST=localhost
DB_PORT=1433
DB_USER=mcp_ro
DB_PASSWORD=your_password_here
DB_NAME=your_database

# Connection Pool Settings
MAX_CONNECTIONS=10
CONNECTION_TIMEOUT_MS=10000
STATEMENT_TIMEOUT_MS=30000
MAX_ROWS=1000
MAX_AFFECTED_ROWS=100
MAX_RESPONSE_BYTES=1000000
MAX_FIELD_BYTES=65536
MAX_COLUMNS=100
MAX_REQUEST_BYTES=262144
MAX_INPUT_BYTES=65536
MAX_INPUT_ITEMS=100

# Security Settings
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Tool Guards
DEBUG=false
MCP_MODE=read
VERIFY_DB_PRIVILEGES=true
ALLOW_ARBITRARY_SELECT=false
ALLOW_DATABASE_LIST=false
ALLOWED_SCHEMAS=dbo
# ALLOWED_TABLES=dbo.SafeView,dbo.ReportingTable
# ALLOWED_COLUMNS=dbo.SafeView.Id,dbo.SafeView.Status
# ALLOWED_SELECT_FUNCTIONS=count,min,max,avg,lower,upper
ALLOW_WRITES=false
ALLOW_DELETE=false
RETURN_MUTATION_ROWS=false
AUDIT_LOG=true
ALLOW_STORED_PROCEDURES=false
ALLOWED_PROCEDURES=dbo.GetUsersByStatus
